<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/artMovementRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ai_curator_black_500"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_detail_back"
            android:contentDescription="뒤로가기" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Art movements"
            android:textColor="@color/ai_curator_cream"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/noto_sans_mono" />
    </LinearLayout>

    <ViewStub
        android:id="@+id/searchStub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout="@layout/view_search_bar"
        android:inflatedId="@+id/searchContainer"
        android:layout_marginTop="12dp" />

    <!-- Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/movementGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="16dp" />
</LinearLayout>