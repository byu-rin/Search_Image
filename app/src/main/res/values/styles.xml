<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- To see how these attributes are used, please visit https://material.io/develop/android/theming/color/ -->
    <style name="Base.Theme.AiCurator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ai_curator_green_500</item>
        <item name="colorOnPrimary">@color/ai_curator_yellow_500</item>
        <item name="colorPrimaryDark">@color/ai_curator_green_700</item>
        <item name="colorOnSurface">@color/ai_curator_black</item>
        <item name="colorAccent">@color/ai_curator_green_700</item>
        <item name="colorSurface">@color/ai_curator_gray_50</item>
        <item name="colorSecondary">@color/ai_curator_yellow_500</item>
        <item name="android:colorBackground">@color/ai_curator_green_500</item>
    </style>

    <style name="Theme.AICurator" parent="Base.Theme.AiCurator"/>

    <style name="Theme.AICurator.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.AICurator.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar"/>

    <style name="TextAppearance.AICurator.Toolbar.Text" parent="TextAppearance.MaterialComponents.Headline5" >
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

</resources>